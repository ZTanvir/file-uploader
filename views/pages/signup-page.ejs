<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="../../public/styles/reset.css" />
    <link rel="stylesheet" href="../../public/styles/global.css" />
    <link rel="stylesheet" href="../../public/styles/pages/signup-page.css" />
    <title>File Storage</title>
  </head>
  <body id="signup-page">
    <header><%- include("../partials/navbar") %></header>
    <main data-center="center-child">
      <form
        data-stack
        style="--gutter: 1rem"
        action=""
        method="post"
        id="signup-form"
      >
        <h1 data-center="center-text" class="form-title">Sign Up</h1>
        <div data-stack style="--gutter: 0.25rem">
          <label for="username">Username:</label>
          <input type="text" name="username" id="username" />
        </div>
        <div data-stack style="--gutter: 0.25rem">
          <label for="password">Password:</label>
          <input type="password" name="password" id="password" />
        </div>
        <div data-stack style="--gutter: 0.25rem">
          <label for="confirm-password">Confirm Password:</label>
          <input type="password" name="confirmPassword" id="confirm-password" />
        </div>
        <button class="signupBtn">Sign up</button>
        <div data-inline="space-between" style="--gutter: 0.25rem">
          <a href="#">Help</a>
          <span>Already have an account? <a href="/log-in">Log in</a></span>
        </div>
      </form>
    </main>
    <%- include("../partials/footer") %>
  </body>
</html>
