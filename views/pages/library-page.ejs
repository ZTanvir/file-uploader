<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%- include("../partials/favicon") %>
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/public/styles/reset.css" />
    <link rel="stylesheet" href="/public/styles/global.css" />
    <link rel="stylesheet" href="/public/styles/pages/library-page.css" />
    <title>Library</title>
    <script defer src="/public/scripts/library-page.js"></script>
  </head>
  <body id="library-page">
    <header><%- include("../partials/navbar") %></header>
    <main>
      <div class="library-header">
        <%if(folderData.parentFolder.id){ %>
        <!-- window history api -->
        <div class="redirect-previous-page">
          <a data-inline style="--gutter: 0.5rem">
            <span class="material-symbols-outlined"> arrow_back </span
            ><%=folderData.parentFolder.name%>
          </a>
        </div>
        <% }else{ %>
        <div class="my-library">
          <span class="material-symbols-outlined"> folder </span>My Library
        </div>
        <% } %>
        <!-- Create folder based on folder name -->
        <div class="new-folder">
          <button
            data-inline
            style="--gutter: 0.5rem"
            class="show-new-folder-dialog"
          >
            <span class="material-symbols-outlined"> create_new_folder </span
            ><span> New Folder</span>
          </button>

          <dialog id="add-folder-dialog">
            <form
              data-stack
              data-parent-folder-id="<%=String(folderData.parentFolder.id)%>"
              style="--gutter: 0.5rem"
              id="add-folder-dialog__form"
            >
              <div>
                <label for="folder-name">Folder Name:</label>
                <input
                  type="text"
                  id="folder-name"
                  name="folderName"
                  required
                />
              </div>
              <div class="button-group">
                <button type="submit">Submit</button>
                <button type="button" class="close-add-folder-dialog">
                  Close
                </button>
              </div>
            </form>
          </dialog>
        </div>

        <!-- Trigger upload file modal -->
        <div class="upload-file">
          <span class="material-symbols-outlined"> upload </span>
          <span>Upload file</span>
        </div>
      </div>
      <div class="library-body">
        <table class="folderInfoTable" data-center>
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Size</th>
              <th class="created-col" scope="col">Created</th>
              <th class="updated-col" scope="col">Last Update</th>
              <th scope="col">Options</th>
            </tr>
          </thead>
          <tbody>
            <% if(folderData.folderList.length){
            folderData.folderList.forEach(folder => { %>
            <tr>
              <td class="folder-name-row">
                <a
                  data-inline
                  style="--gutter: 0.5rem"
                  href="<%=`/library/${folder.id}`%>"
                  ><span class="material-symbols-outlined"> folder </span
                  ><span> <%= folder.name %></span></a
                >
              </td>
              <td></td>
              <td class="created-row"><%=folder.createdAt %></td>
              <td class="updated-row"><%=folder.updatedAt %></td>
              <td>
                <div class="folder-options">
                  <span
                    class="material-symbols-outlined open-folder-options-btn"
                  >
                    more_vert
                  </span>
                  <dialog id="folder-options-dialog">
                    <div
                      data-stack
                      style="--gutter: 0.25rem"
                      class="folder-options-button-group"
                    >
                      <button
                        type="button"
                        class="update-folder-btn"
                        data-folder-id="<%=String(folder.id)%>"
                        data-folder-name="<%=String(folder.name)%>"
                      >
                        <span class="material-symbols-outlined"> edit </span
                        >Edit
                      </button>
                      <button
                        type="button"
                        data-folder-id="<%=String(folder.id)%>"
                        class="delete-folder-btn"
                      >
                        <span class="material-symbols-outlined"> delete </span>
                        Delete
                      </button>
                    </div>
                  </dialog>
                </div>
              </td>
            </tr>
            <% })}if(folderData.fileList.length){
            folderData.fileList.forEach(file=>{ %>
            <tr>
              <td class="file-name-row">
                <a
                  data-inline
                  style="--gutter: 0.5rem"
                  href="/library/file/fileDetails/<%=String(file.id)%>"
                  ><span class="material-symbols-outlined"> files </span
                  ><span> <%=file.name %></span></a
                >
              </td>
              <td><%=file.size%></td>
              <td class="created-row"><%=file.createdAt%></td>
              <td class="updated-row"><%=file.updatedAt%></td>
              <td>
                <div class="file-options">
                  <span class="material-symbols-outlined open-file-options-btn">
                    more_vert
                  </span>
                  <dialog id="file-options-dialog">
                    <div
                      data-stack
                      style="--gutter: 0.25rem"
                      class="file-options-button-group"
                    >
                      <a href="/library/file/<%=String(file.id)%>">
                        <button type="button" class="download-file-btn">
                          <span class="material-symbols-outlined"
                            >download</span
                          >
                          Download
                        </button>
                      </a>
                      <button
                        type="button"
                        class="update-file-btn"
                        data-file-id="<%=String(file.id)%>"
                        data-file-name="<%=String(file.name)%>"
                      >
                        <span class="material-symbols-outlined"> edit </span
                        >Edit
                      </button>
                      <button
                        type="button"
                        data-file-id="<%=String(file.id)%>"
                        class="delete-file-btn"
                      >
                        <span class="material-symbols-outlined"> delete </span>
                        Delete
                      </button>
                    </div>
                  </dialog>
                </div>
              </td>
            </tr>
            <%})}if(!folderData.folderList.length &&
            !folderData.fileList.length){ %>
            <tr>
              <td colspan="5">The folder is empty</td>
            </tr>
            <%} %>
          </tbody>
        </table>
      </div>

      <dialog class="file-upload-modal">
        <form
          id="upload-file-form"
          method="post"
          enctype="multipart/form-data"
          data-stack
          data-parent-folder-id="<%=String(folderData.parentFolder.id)%>"
          style="--gutter: 0.75rem"
        >
          <div data-inline="space-between">
            <p class="title">Upload to my library</p>
            <button type="reset" class="close-modal-btn">
              <span class="close-modal-icon">&#10005;</span>
            </button>
          </div>
          <p class="msg"></p>
          <input id="upload_file" type="file" name="upload_file" />
          <p class="file-max-size">(Max: 5MB)</p>
          <button class="submit-btn" type="submit">Upload File</button>
        </form>
      </dialog>

      <dialog id="folder-rename-modal">
        <div data-stack style="--gutter: 0.5rem">
          <div data-inline="space-between">
            <span>Rename </span>
            <button class="close-rename-folder-modal-btn">
              <span class="material-symbols-outlined"> close </span>
            </button>
          </div>
          <hr />
          <form id="folder-rename-form" data-stack style="--gutter: 0.5rem">
            <div data-stack style="--gutter: 0.5rem">
              <label for="updated-folder-name">Name</label>
              <input
                type="text"
                name="updated-folder"
                id="updated-folder-name"
                required
              />
            </div>
            <button type="submit">Save</button>
          </form>
        </div>
      </dialog>

      <dialog id="file-rename-modal">
        <div data-stack style="--gutter: 0.5rem">
          <div data-inline="space-between">
            <span>Rename </span>
            <button class="close-rename-file-modal-btn">
              <span class="material-symbols-outlined"> close </span>
            </button>
          </div>
          <hr />
          <form id="file-rename-form" data-stack style="--gutter: 0.5rem">
            <div data-stack style="--gutter: 0.5rem">
              <label for="updated-file-name">Name</label>
              <input
                type="text"
                name="updated-file"
                id="updated-file-name"
                required
              />
            </div>
            <button type="submit">Save</button>
          </form>
        </div>
      </dialog>
    </main>
    <%- include("../partials/footer") %>
  </body>
</html>
