<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="../../public/styles/reset.css" />
    <link rel="stylesheet" href="../../public/styles/global.css" />
    <link rel="stylesheet" href="../../public/styles/pages/library-page.css" />
    <title>Document</title>
  </head>
  <body id="library-page">
    <header><%- include("../partials/navbar") %></header>
    <main>
      <div class="library-header">
        <div class="my-library">
          <span class="material-symbols-outlined"> folder </span>My Library
        </div>
        <div class="new-folder">
          <span class="material-symbols-outlined"> create_new_folder </span
          ><span>New Folder</span>
        </div>
        <div class="upload-file">
          <span class="material-symbols-outlined"> upload </span>
          <span>Upload file</span>
        </div>
      </div>
      <dialog class="file-upload-modal">
        <form
          id="upload-file-form"
          action="/upload"
          method="post"
          enctype="multipart/form-data"
          data-stack
          style="--gutter: 0.75rem"
        >
          <div data-inline="space-between">
            <h2>Upload to my library</h2>
            <button class="close-modal-btn" formmethod="dialog" type="submit">
              <span class="close-modal-icon">&#10005;</span>
            </button>
          </div>
          <input id="upload_file" type="file" name="upload_file" />
          <button type="submit">Submit</button>
        </form>
      </dialog>
    </main>
    <%- include("../partials/footer") %>
  </body>
  <script>
    const dialog = document.querySelector(".file-upload-modal");
    const modalTriggerBtn = document.querySelector(".upload-file");
    modalTriggerBtn.addEventListener("click", (e) => {
      dialog.showModal();
    });
  </script>
</html>
